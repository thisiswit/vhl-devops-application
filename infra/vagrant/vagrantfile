Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  config.vm.define "vhl-k8s" do |node|
    node.vm.hostname = "vhl-k8s"

    node.vm.network "private_network", ip: "192.168.56.10"

    node.vm.network "forwarded_port",
      guest: 80,
      host: 8080,
      host_ip: "127.0.0.1",
      auto_correct: true

    node.vm.network "forwarded_port",
      guest: 443,
      host: 8443,
      host_ip: "127.0.0.1",
      auto_correct: true

    node.vm.network "forwarded_port",
      guest: 6443,
      host: 6443,
      host_ip: "127.0.0.1",
      auto_correct: true

    node.vm.synced_folder "../..", "/workspace"

    node.vm.provider "virtualbox" do |vb|
      vb.name = "vhl-k8s"
      vb.cpus = 2
      vb.memory = 4096
    end

    node.vm.provision "shell", path: "scripts/install-k3s.sh"
  end
end